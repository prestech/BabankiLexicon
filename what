receivers:
  otlp:
    protocols:
      grpc:
        endpoint: 0.0.0.0:4317
      http:
        endpoint: 0.0.0.0:4318

processors:
  batch:
    timeout: 1s
    send_batch_size: 1000

exporters:
  otlphttp/datadog:
    endpoint: https://api.datadoghq.com
    headers:
      dd-api-key: ${env:DD_API_KEY}

service:
  pipelines:
    traces:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlphttp/datadog]
    metrics:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlphttp/datadog]
    logs:
      receivers: [otlp]
      processors: [batch]
      exporters: [otlphttp/datadog]

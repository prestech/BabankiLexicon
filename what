-- Step 1: Create the custom role for MuleSoft integration
CREATE ROLE IF NOT EXISTS mule_integration_role
  COMMENT = 'Custom role for MuleSoft integration with specific schema access';

-- Step 2: Grant necessary privileges to the role
-- Replace 'my_database' and 'my_schema1', 'my_schema2' with your actual database and schema names
GRANT USAGE ON DATABASE my_database TO ROLE mule_integration_role;
GRANT USAGE ON SCHEMA my_database.my_schema1 TO ROLE mule_integration_role;
GRANT USAGE ON SCHEMA my_database.my_schema2 TO ROLE mule_integration_role;
GRANT SELECT, INSERT, UPDATE ON ALL TABLES IN SCHEMA my_database.my_schema1 TO ROLE mule_integration_role;
GRANT SELECT, INSERT, UPDATE ON ALL TABLES IN SCHEMA my_database.my_schema2 TO ROLE mule_integration_role;
-- Grant usage on warehouse for query execution (replace 'compute_wh' with your warehouse)
GRANT USAGE ON WAREHOUSE compute_wh TO ROLE mule_integration_role;

-- Step 3: Create the user with public-private key authentication
CREATE USER IF NOT EXISTS mule_integration_dev
  LOGIN_NAME = 'MULE_INTEGRATION_DEV'
  DISPLAY_NAME = 'MuleSoft Integration Dev'
  DEFAULT_ROLE = mule_integration_role
  DEFAULT_WAREHOUSE = 'compute_wh' -- Replace with your warehouse
  DEFAULT_NAMESPACE = 'my_database.my_schema1' -- Optional, set default schema
  COMMENT = 'User for MuleSoft integration with key-pair authentication'
  MUST_CHANGE_PASSWORD = FALSE; -- No password, so this is irrelevant but set for clarity

-- Step 4: Assign the custom role to the user
GRANT ROLE mule_integration_role TO USER mule_integration_dev;

-- Step 5: Set up public key for key-pair authentication
-- Replace '<public_key_content>' with the actual RSA public key (without BEGIN/END markers)
ALTER USER mule_integration_dev
  SET RSA_PUBLIC_KEY = 'MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...'; -- Add your public key here

-- Step 6: Verify user and role setup
SHOW USERS LIKE 'MULE_INTEGRATION_DEV';
SHOW GRANTS TO USER mule_integration_dev;
SHOW GRANTS ON ROLE mule_integration_role;

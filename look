$hostname = "myserver.com"
$port = 443
openssl s_client -connect "${hostname}:${port}" -servername $hostname -showcerts 2>$null | Out-File -Encoding ascii certs.txt
Select-String -Path certs.txt -Pattern "-----BEGIN CERTIFICATE-----","-----END CERTIFICATE-----" -Context 0,1000 | 
    Select-Object -First 2 | 
    ForEach-Object { $_.Line; if ($_.Context.PostContext) { $_.Context.PostContext } } | 
    Out-File -Encoding ascii server_cert.pem

--Step 2

$pkcs12Password = "pkcs12password"
openssl pkcs12 -export -in server_cert.pem -inkey private_key.key -out keystore.p12 -name myalias -passout pass:$pkcs12Password


$pkcs12Password = "pkcs12password"
$jksPassword = "jkspassword"
keytool -importkeystore -srckeystore keystore.p12 -srcstoretype PKCS12 -srcstorepass $pkcs12Password -destkeystore keystore.jks -deststoretype JKS -deststorepass $jksPassword -alias myalias

--step 3

keytool -list -keystore keystore.jks -storepass $jksPassword

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:salesforce="http://www.mulesoft.org/schema/mule/salesforce"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core">
    <http:listener-config name="HTTP_Listener_Configuration" host="0.0.0.0" port="8081"/>
    <http:request-config name="HTTP_Request_Configuration" host="login.salesforce.com" port="443" protocol="HTTPS">
        <http:client-connections>
            <http:client-connection>
                <tls:context>
                    <tls:trust-store path="src/main/resources/keystore.jks" password="yourKeystorePassword"/>
                    <tls:key-store path="src/main/resources/keystore.jks" alias="yourCertAlias" keyPassword="yourKeystorePassword" password="yourKeystorePassword"/>
                </tls:context>
            </http:client-connection>
        </http:client-connections>
    </http:request-config>
    <salesforce:sfdc-config name="Salesforce_OAuth_JWT" doc:name="Salesforce OAuth JWT">
        <salesforce:oauth-jwt-connection consumerKey="${sf.consumerKey}"
            keyStore="${mule.home}/apps/${app.name}/keystore.jks"
            storePassword="yourKeystorePassword"
            certificateAlias="yourCertAlias"
            principal="yourSalesforceUsername"
            tokenEndpoint="https://login.salesforce.com/services/oauth2/token"
            audienceUrl="https://login.salesforce.com"/>
    </salesforce:sfdc-config>
    <flow name="salesforce-jwt-flow">
        <http:listener config-ref="HTTP_Listener_Configuration" path="/auth"/>
        <ee:transform doc:name="Generate JWT">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
import java!org::mule::extension::jwt::JwtUtils
---
{
    jwt: JwtUtils.createJwt({
        header: { alg: "RS256", typ: "JWT" },
        payload: {
            iss: "${sf.consumerKey}",
            sub: "${sf.principal}",
            aud: "${sf.aud}",
            exp: (now() + |PT2M|) as String {format: "epoch"}
        },
        keyStore: "${mule.home}/apps/${app.name}/keystore.jks",
        keyAlias: "yourCertAlias",
        keyPassword: "yourKeystorePassword"
    })
}
]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <http:request method="POST" path="/services/oauth2/token" config-ref="HTTP_Request_Configuration">
            <http:query-params>
                #[{'grant_type': 'urn:ietf:params:oauth:grant-type:jwt-bearer', 'assertion': payload.jwt}]
            </http:query-params>
        </http:request>
        <set-variable variableName="sfToken" value="#[output application/json --- payload.access_token]"/>
        <salesforce:query config-ref="Salesforce_OAuth_JWT" query="SELECT Id, Name FROM Account"/>
    </flow>
</mule>

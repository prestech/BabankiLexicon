def resolve_relationships(tdoc, block, block_map=None, depth=0, visited=None):
    """
    Recursively resolve relationships for a given block in a TDocument.
    
    Args:
        tdoc (TDocument): The parsed Textract document.
        block (TBlock): The current block to process.
        block_map (dict, optional): A map of block IDs to TBlock objects for quick lookup.
        depth (int): Recursion depth for indentation (debugging).
        visited (set, optional): Set of block IDs to prevent infinite loops.
    
    Returns:
        list: A list of dictionaries containing block details and their resolved relationships.
    """
    if block_map is None:
        block_map = {b.id: b for b in tdoc.blocks}  # Create a map of all blocks
    
    if visited is None:
        visited = set()  # Track visited blocks to avoid cycles
    
    if block.id in visited:
        return []  # Avoid infinite recursion
    
    visited.add(block.id)
    result = {
        "block_type": block.block_type,
        "text": block.text if block.text else None,
        "confidence": block.confidence,
        "geometry": block.geometry,
        "children": []
    }
    
    # Get related blocks (e.g., CHILD relationships)
    related_blocks = tdoc.get_relationships_for_block(block)
    for rel_block in related_blocks:
        child_data = resolve_relationships(tdoc, rel_block, block_map, depth + 1, visited)
        result["children"].append(child_data)
    
    return [result]

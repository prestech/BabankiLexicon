AWSTemplateFormatVersion: '2010-09-09'
Description: CloudFormation template to launch a Windows EC2 instance in an existing VPC and subnet with no public IP, with Apache JMeter, Java, and Google Chrome installed.

Parameters:
  KeyName:
    Type: AWS::EC2::KeyPair::KeyName
    Description: Name of an existing EC2 KeyPair to enable RDP access to the instance
    ConstraintDescription: Must be the name of an existing EC2 KeyPair.

  InstanceType:
    Type: String
    Default: r5.xlarge
    Description: EC2 instance type (r5.xlarge for 32GB RAM, as t3.large only supports 8GB)
    AllowedValues:
      - r5.xlarge
      - t3.large
    ConstraintDescription: Must be a valid EC2 instance type.

  VpcId:
    Type: AWS::EC2::VPC::Id
    Description: ID of the existing VPC (e.g., vpc-12345678)
    ConstraintDescription: Must be a valid VPC ID.

  SubnetId:
    Type: AWS::EC2::Subnet::Id
    Description: ID of the existing subnet in the VPC (e.g., subnet-12345678)
    ConstraintDescription: Must be a valid subnet ID in the specified VPC.

  LatestWindowsAmiId:
    Type: AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>
    Default: /aws/service/ami-windows-latest/Windows_Server-2019-English-Full-Base
    Description: Latest Windows Server 2019 AMI

Resources:
  InstanceSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      GroupDescription: Enable RDP and JMeter ports within VPC
      VpcId: !Ref VpcId
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 3389
          ToPort: 3389
          CidrIp: 0.0.0.0/0
          Description: Allow RDP access
        - IpProtocol: tcp
          FromPort: 1099
          ToPort: 1099
          CidrIp: 0.0.0.0/0
          Description: Allow JMeter RMI port
        - IpProtocol: tcp
          FromPort: 50000
          ToPort: 50000
          CidrIp: 0.0.0.0/0
          Description: Allow JMeter server port

  EC2Instance:
    Type: AWS::EC2::Instance
    Properties:
      InstanceType: !Ref InstanceType
      ImageId: !Ref LatestWindowsAmiId
      KeyName: !Ref KeyName
      SubnetId: !Ref SubnetId
      AssociatePublicIpAddress: false
      BlockDeviceMappings:
        - DeviceName: /dev/sda1
          Ebs:
            VolumeSize: 50
            VolumeType: gp3
      SecurityGroupIds:
        - !Ref InstanceSecurityGroup
      UserData:
        Fn::Base64: !Sub |
          <powershell>
          # Set execution policy
          Set-ExecutionPolicy -Scope CurrentUser -ExecutionPolicy RemoteSigned -Force

          # Install Chocolatey package manager
          Set-ExecutionPolicy Bypass -Scope Process -Force; [System.Net.ServicePointManager]::SecurityProtocol = [System.Net.ServicePointManager]::SecurityProtocol -bor 3072; iex ((New-Object System.Net.WebClient).DownloadString('https://community.chocolatey.org/install.ps1'))

          # Install Java (OpenJDK)
          choco install openjdk11 -y

          # Install Google Chrome
          choco install googlechrome -y

          # Install Apache JMeter
          choco install jmeter -y

          # Configure Windows Firewall to allow JMeter traffic
          New-NetFirewallRule -DisplayName "Allow JMeter" -Direction Inbound -Program "C:\ProgramData\chocolatey\lib\jmeter\tools\apache-jmeter-5.6.3\bin\jmeter.bat" -Action Allow -Enabled True

          # Restart to ensure all installations take effect
          Restart-Computer -Force
          </powershell>
      Tags:
        - Key: Name
          Value: Windows-JMeter-Instance

Outputs:
  InstanceId:
    Description: Instance ID of the EC2 instance
    Value: !Ref EC2Instance
  PrivateIP:
    Description: Private IP address of the EC2 instance
    Value: !GetAtt EC2Instance.PrivateIp

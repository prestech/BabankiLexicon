
%dw 2.0
output application/json
import * from jwt::RSA
---
{
    token: JWT(
        {
            "alg": "RS256",
            "typ": "JWT"
        },
        {
            iss: "${sf.consumerKey}",
            sub: "${sf.principal}",
            aud: "${sf.aud}",
            exp: (now() + |PT2M|) as Number {unit: "seconds"}
        },
        readUrl("classpath://keystore.jks", "application/octet-stream") as String,
        "Sha256withRSA"
    )
}

def execute_athena_msk_repair(table_name: str, database: str, output_location: str, region: str = 'us-east-1') -> str:
    """
    Execute MSCK REPAIR TABLE on an Athena table.
    
    Parameters:
    - table_name: Name of the table to repair
    - database: Athena database name
    - output_location: S3 URI for query results (e.g., "s3://my-bucket/athena-results/")
    - region: AWS region
    
    Returns:
    - Query execution ID
    """
    # Initialize Athena client
    athena_client = boto3.client('athena', region_name=region)
    
    # Construct the MSCK REPAIR TABLE query
    query = f"MSCK REPAIR TABLE {table_name}"
    
    try:
        # Start the query execution
        response = athena_client.start_query_execution(
            QueryString=query,
            QueryExecutionContext={
                'Database': database
            },
            ResultConfiguration={
                'OutputLocation': output_location
            }
        )
        query_execution_id = response['QueryExecutionId']
        print(f"Started MSCK REPAIR TABLE with execution ID: {query_execution_id}")
        
        # Wait for the query to complete
        while True:
            query_status = athena_client.get_query_execution(QueryExecutionId=query_execution_id)
            state = query_status['QueryExecution']['Status']['State']
            
            if state in ['SUCCEEDED', 'FAILED', 'CANCELLED']:
                break
            print(f"Query state: {state}. Waiting...")
            time.sleep(2)  # Poll every 2 seconds
        
        # Check final status
        if state == 'SUCCEEDED':
            print(f"MSCK REPAIR TABLE {table_name} succeeded")
            return query_execution_id
        elif state == 'FAILED':
            reason = query_status['QueryExecution']['Status'].get('StateChangeReason', 'Unknown error')
            raise Exception(f"Query failed: {reason}")
        else:
            raise Exception("Query was cancelled")
            
    except ClientError as e:
        print(f"Athena error: {e}")
        raise
    except Exception as e:
        print(f"Error: {e}")
        raise

$hostname = "myserver.com"
$port = 443
openssl s_client -connect "${hostname}:${port}" -servername $hostname -showcerts 2>$null | Out-File -Encoding ascii certs.txt
Select-String -Path certs.txt -Pattern "-----BEGIN CERTIFICATE-----","-----END CERTIFICATE-----" -Context 0,1000 | 
    Select-Object -First 2 | 
    ForEach-Object { $_.Line; if ($_.Context.PostContext) { $_.Context.PostContext } } | 
    Out-File -Encoding ascii server_cert.pem
